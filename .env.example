# ============================================
# 社交媒体用户风险分析系统 - 环境变量配置模板
# ============================================
# 使用说明：
# 1. 复制此文件为 .env：cp .env.example .env
# 2. 填写实际的配置值
# 3. .env 文件不会被提交到 git（已在 .gitignore 中）
# ============================================

# -------------------- 数据库配置 --------------------
# MySQL 数据库密码（必填）
DB_PASSWORD=your_db_password_here

# -------------------- LLM API 配置 --------------------
# OpenAI API Key（必填）
# 如果使用内网服务，填写 "local" 即可
OPENAI_API_KEY=local

# -------------------- 钉钉推送配置 --------------------
# 钉钉机器人 Webhook URL（可选，启用钉钉推送时必填）
# 格式：https://oapi.dingtalk.com/robot/send?access_token=xxx
# 留空则不推送到钉钉
DINGTALK_WEBHOOK=

# -------------------- 其他配置 --------------------
# 如需添加其他环境变量，请在此处添加
# 例如：
# PROXY_HOST=127.0.0.1
# PROXY_PORT=7897

